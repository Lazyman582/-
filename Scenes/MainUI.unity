--- !u!114 &991470766
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 991470764}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 97cf2b197ea01074e8c62234f1a22d04, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lines:
  - "\u6545\u4E8B\u7684\u5F00\u7AEF\uFF0C\u8981\u5148\u4ECE\u300C\u706B\u300D\u5F00\u59CB"
  - "\u5728\u5B83\u8BDE\u751F\u4E4B\u524D\uFF0C\u8FD9\u4E2A\u4E16\u754C\u662F\u9ED1\u6697\u7684\uFF0C\u5B89\u9759\u7684"
  - "\u4EC0\u4E48\u751F\u547D\u90FD\u4E0D\u5B58\u5728"
  - "\u90A3\u65F6\u4E16\u754C\u7684\u4E3B\u5BB0\u662F\u6B7B\u7269\u2014\u2014\u2014\u77F3\u5757\uFF0C\u91D1\u5C5E"
  - "\u5B83\u4EEC\u4E00\u52A8\u4E0D\u52A8\u7684\u7EDF\u6CBB\u7740\u3002\u4E98\u53E4\u4E0D\u53D8\u7684\u6A2A\u7AD6\u5728\u5927\u5730\u4E4B\u4E0A"
  - "\u76F4\u5230\uFF0C\u6709\u671D\u4E00\u65E5"
  - "\u4E00\u4EFD\u5149\u4EAE\uFF0C\u4E00\u4EFD\u6E29\u6696\uFF0C\u7A81\u5140\u7684\u8BDE\u751F\u5728\u8FD9\u7247\u6B7B\u5BC2\u6C89\u6C89\u7684\u5927\u5730"
  - "\u5B83\u5E26\u6765\u4E86\u751F\u673A\uFF0C\u8BA9\u5927\u5730\u8BDE\u751F\u6D3B\u7269\uFF0C\u5E76\u7531\u6B64\u8BA9\u6587\u660E\u62D4\u5730\u800C\u8D77"
  - "\u9AD8\u8038\u5165\u4E91\u7684\u57CE\u6C60\uFF0C\u5E7D\u6DF1\u9759\u8C27\u7684\u5EAD\u9662\uFF0C\u4EE5\u53CA\u5B89\u5C45\u4E50\u4E1A\u7684\u4EBA\u4EEC"
  - "\u5C31\u6B64\u5343\u767E\u5E74\u901D\u53BB\uFF0C\u76F4\u81F3\u300C\u706B\u300D\u7684\u5FAE\u5F31..."
  - "\u706B\u4E4B\u5C06\u7184\uFF0C\u7136\u4F4D\u4E0D\u89C1\u738B\u5F71"
  - "\u7531\u6B64\u300C\u5947\u8FF9\u300D\u964D\u4E34\uFF0C\u626D\u66F2\u4E3A\u90A3\u4EFD\u6E29\u6696"
  - "\u5B83\u4E3A\u4EBA\u4EEC\u964D\u4E0B\u4E86\u672C\u4E0D\u5C5E\u4E8E\u4ED6\u4EEC\u7684\u82E6\u75DB\uFF0C\u5728\u8FD9\u7247\u571F\u5730\u4E0A\u7559\u4E0B\u4F24\u75D5"
  - "\u7136\u6467\u6BC1\u5B83\uFF0C\u6DF1\u6D77\u65F6\u4EE3\u53C8\u5C06\u518D\u4E34\uFF0C\u5C4A\u65F6\u4E16\u754C\u53C8\u5C06\u5F52\u4E8E\u6B7B\u7269..."
  - ......
  - "\u60A8\u82E5\u82CF\u9192\uFF0C\u4F1A\u53C8\u4F5C\u4F55\u6289\u62E9\uFF1F"
  playOnStart: 1
  charFadeDuration: 0.2

  - text: "\u5947\u8FF9\u7684\u722A\u7259\u6B63\u5927\u8086\u641C\u6355\u7740\u60A8\u7684\u5B58\u5728\uFF0C\u5B83\u4EEC\u60E7\u6015\u60A8"
